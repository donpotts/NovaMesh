@page "/admin/health"
@using System.Net.Http.Json
@using NovaMesh.Client.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>System Health &amp; Diagnostics</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-6 gap-4">
        <div>
            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Success" Rounded="true" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h5" Class="fw-bold">System Health &amp; Diagnostics</MudText>
                        @if (_health != null)
                        {
                            <MudChip T="string" Color="@(_health.Status == "Healthy" ? Color.Success : Color.Warning)" Size="Size.Small">
                                @_health.Status
                            </MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Live infrastructure telemetry, subsystem statuses, GC allocation profiling, and AI gateway connectivity.
                    </MudText>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadHealthAsync">
                Refresh
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="TriggerGcCollectAsync">
                Optimize Memory (GC)
            </MudButton>
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_health != null)
    {
        <!-- KPI Cards -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="1">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Memory" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Allocated Managed Memory</MudText>
                        <MudText Typo="Typo.h6">@((_health.MemoryAllocatedBytes / (1024.0 * 1024.0)).ToString("F2")) MB</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="1">
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Server Uptime</MudText>
                        <MudText Typo="Typo.h6">@($"{_health.Uptime.Hours}h {_health.Uptime.Minutes}m {_health.Uptime.Seconds}s")</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="1">
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Database Latency</MudText>
                        <MudText Typo="Typo.h6">@_health.DatabaseLatencyMs ms</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center gap-4" Elevation="1">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Hub" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Thread Pool Threads</MudText>
                        <MudText Typo="Typo.h6">@_health.ThreadCount</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Subsystems Grid -->
        <MudGrid>
            <!-- Database Subsystem -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Success"><MudIcon Icon="@Icons.Material.Filled.Dns" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Relational Persistence Layer</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Entity Framework Core 10 / SQLite Provider</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@_health.DatabaseStatus</MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                                <MudText Typo="Typo.body2">Connection Test: <strong>Operational</strong> (Latency: @_health.DatabaseLatencyMs ms)</MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Layers" IconColor="Color.Primary">
                                <MudText Typo="Typo.body2">DbSets Registered: <strong>26 Entity Sets</strong></MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">
                                <MudText Typo="Typo.body2">Multi-Tenant Isolation: <strong>EF Core Global Query Filters Active</strong></MudText>
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Ollama & AI Gateway Subsystem -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Psychology" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Ollama &amp; AI Intelligence Gateway</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Neural Model Inference &amp; Vector Embeddings</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_health.OllamaStatus</MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.SmartToy" IconColor="Color.Primary">
                                <MudText Typo="Typo.body2">Selected Active Model: <strong>@_health.ActiveModel</strong></MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.CloudQueue" IconColor="Color.Info">
                                <MudText Typo="Typo.body2">Supported Cloud Providers: <strong>Gemma 4, GPT-OSS, Nemotron-3 Super</strong></MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.ElectricBolt" IconColor="Color.Success">
                                <MudText Typo="Typo.body2">Autonomous Tool Loop: <strong>Active (Zero-Trust Verified)</strong></MudText>
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Garbage Collection & Memory Telemetry -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Warning"><MudIcon Icon="@Icons.Material.Filled.Recycling" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Garbage Collection Profiler</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">.NET 10 Generational Heap Collections</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-space-around text-center my-2">
                            <div>
                                <MudText Typo="Typo.h5" Color="Color.Primary">@_health.Gen0Collections</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 0 Collections</MudText>
                            </div>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <div>
                                <MudText Typo="Typo.h5" Color="Color.Warning">@_health.Gen1Collections</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 1 Collections</MudText>
                            </div>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <div>
                                <MudText Typo="Typo.h5" Color="Color.Error">@_health.Gen2Collections</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Gen 2 (Full GC)</MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Platform Runtime Details -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="Color.Dark"><MudIcon Icon="@Icons.Material.Filled.Terminal" /></MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Platform &amp; Runtime Metadata</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Host Process &amp; Environment</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.SettingsSystemDaydream" IconColor="Color.Default">
                                <MudText Typo="Typo.body2">Application Version: <strong>@_health.AppVersion</strong></MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Code" IconColor="Color.Default">
                                <MudText Typo="Typo.body2">.NET Runtime: <strong>.NET @_health.DotNetVersion</strong></MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Public" IconColor="Color.Default">
                                <MudText Typo="Typo.body2">Hosting Environment: <strong>@_health.Environment</strong></MudText>
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private SystemHealthDto? _health;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        _loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<SystemHealthDto>("/api/system/health");
            if (res != null) _health = res;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load diagnostics: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TriggerGcCollectAsync()
    {
        try
        {
            var resp = await Http.PostAsync("/api/system/gc-collect", null);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                Snackbar.Add("Garbage Collection executed! Memory optimized.", Severity.Success);
                await LoadHealthAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"GC optimization failed: {ex.Message}", Severity.Error);
        }
    }
}