@page "/account/profile"
@inject HttpClient Http
@inject AuthService Auth
@inject ISnackbar Snackbar

<PageTitle>My Profile</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" />My Account Profile</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Manage your account identity, security credentials, and active permissions</MudText>
</div>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Account Information</MudText>
            <MudTextField @bind-Value="fullName" Label="Full Name" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="email" Label="Email Address" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="phone" Label="Phone Number" Variant="Variant.Outlined" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateProfile">Save Profile</MudButton>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Change Password</MudText>
            <MudTextField @bind-Value="currentPassword" Label="Current Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="newPassword" Label="New Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ChangePassword">Update Password</MudButton>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string fullName = "System Administrator";
    private string email = "admin@nexus.local";
    private string phone = "+1 (555) 0199";
    private string currentPassword = "";
    private string newPassword = "";

    protected override void OnInitialized()
    {
        if (Auth.CurrentUser != null)
        {
            fullName = Auth.CurrentUser.FullName;
            email = Auth.CurrentUser.Email;
        }
    }

    private async Task UpdateProfile()
    {
        var res = await Http.PutAsJsonAsync("/api/account/my-profile", new UpdateProfileRequest(fullName, email, phone));
        if (res.IsSuccessStatusCode) Snackbar.Add("Profile saved.", Severity.Success);
        else Snackbar.Add("Error updating profile.", Severity.Error);
    }

    private async Task ChangePassword()
    {
        var res = await Http.PostAsJsonAsync("/api/account/change-password", new ChangePasswordRequest(currentPassword, newPassword));
        if (res.IsSuccessStatusCode) Snackbar.Add("Password updated successfully.", Severity.Success);
        else Snackbar.Add("Invalid current password.", Severity.Error);
    }
}