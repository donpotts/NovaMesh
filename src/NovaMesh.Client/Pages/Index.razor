@code {
    private DashboardAnalyticsDto? analytics;

    // Chart 1: Traffic
    private List<ChartSeries> trafficSeries = new();
    private string[] xAxisLabels = new[] { "00:00", "04:00", "08:00", "12:00", "16:00", "20:00", "Now" };

    // Chart 2: Status Codes
    private double[] statusData = Array.Empty<double>();
    private string[] statusLabels = Array.Empty<string>();

    // Chart 3: AI Usage
    private List<ChartSeries> aiSeries = new();
    private string[] aiXLabels = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    // Chart 4: Tenants
    private double[] tenantData = Array.Empty<double>();
    private string[] tenantLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnTenantChanged += OnTenantUpdated;
        Auth.OnAuthStateChanged += OnAuthUpdated;
        if (Auth.IsAuthenticated)
        {
            await LoadDashboard();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Auth.IsAuthenticated)
        {
            await LoadDashboard();
        }
    }

    public void Dispose()
    {
        TenantState.OnTenantChanged -= OnTenantUpdated;
        Auth.OnAuthStateChanged -= OnAuthUpdated;
    }

    private void OnTenantUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void OnAuthUpdated()
    {
        if (Auth.IsAuthenticated)
        {
            await LoadDashboard();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SwitchTenant(TenantDto? tenant)
    {
        await TenantState.SelectTenantAsync(tenant, Theme);
    }

    private async Task LoadDashboard()
    {
        try
        {
            analytics = await Http.GetFromJsonAsync<DashboardAnalyticsDto>("/api/analytics/dashboard");
            if (analytics != null)
            {
                xAxisLabels = analytics.HourlyTrafficLabels;
                trafficSeries = new List<ChartSeries>
                {
                    new ChartSeries { Name = "Requests", Data = analytics.RequestCounts },
                    new ChartSeries { Name = "Latency (ms)", Data = analytics.LatencyMs }
                };

                statusData = analytics.StatusCodeCounts;
                statusLabels = analytics.StatusCodeLabels;

                aiXLabels = analytics.AiUsageLabels;
                aiSeries = new List<ChartSeries>
                {
                    new ChartSeries { Name = "Vector Queries", Data = analytics.AiVectorQueries },
                    new ChartSeries { Name = "Tokens (k)", Data = analytics.AiTokensConsumed.Select(v => v / 100).ToArray() }
                };

                tenantData = analytics.TenantCounts;
                tenantLabels = analytics.TenantDistributionLabels;
            }
        }
        catch { }
    }

    private async Task OpenLogin() => await DialogService.ShowAsync<Components.LoginDialog>("Authentication", new DialogParameters { ["InitialTab"] = 0 });
    private async Task OpenRegister() => await DialogService.ShowAsync<Components.LoginDialog>("Authentication", new DialogParameters { ["InitialTab"] = 1 });
    private async Task QuickLogin(string u, string p)
    {
        var success = await Auth.LoginAsync(u, p);
        if (success)
        {
            await LoadDashboard();
            StateHasChanged();
        }
    }
    private async Task SwitchUser(string u, string p) => await QuickLogin(u, p);
}