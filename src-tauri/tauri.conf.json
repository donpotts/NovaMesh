{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Ask2App - My Platform",
  "version": "1.0.0",
  "identifier": "com.ask2app.platform",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5001",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ask2App | My Platform",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "binaries/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ask2App",
    "copyright": "Copyright © 2026 Ask2App. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Enterprise application framework and desktop workspace",
    "longDescription": "Ask2App | My Platform enables automated full-stack deployments, running background migrations, server APIs, and MudBlazor WebAssembly client.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": null
      }
    }
  }
}