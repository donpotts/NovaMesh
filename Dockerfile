# =============================================================================
# Multi-Stage Production Dockerfile for NovaMesh
# Generated by Forge CLI (https://ask2app.com)
# =============================================================================

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

COPY ["src/NovaMesh.Data/NovaMesh.Data.csproj", "src/NovaMesh.Data/"]
COPY ["src/NovaMesh.DbMigrator/NovaMesh.DbMigrator.csproj", "src/NovaMesh.DbMigrator/"]
COPY ["src/NovaMesh.ServiceDefaults/NovaMesh.ServiceDefaults.csproj", "src/NovaMesh.ServiceDefaults/"]
COPY ["src/NovaMesh.Api/NovaMesh.Api.csproj", "src/NovaMesh.Api/"]
RUN dotnet restore "src/NovaMesh.Api/NovaMesh.Api.csproj"

COPY . .
WORKDIR "/src/src/NovaMesh.Api"
RUN dotnet build "NovaMesh.Api.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "NovaMesh.Api.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "NovaMesh.Api.dll"]
